{
  "name": "openremote-app",
  "version": "1.0.0",
  "license": "FSL-1.1-MIT",
  "packageManager": "bun@1.3.14",
  "main": "index.ts",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "APP_VARIANT=development expo run:ios --device",
    "dev:prebuild": "rm -rf ios/openremote ios/openremote.xcodeproj ios/openremote.xcworkspace && APP_VARIANT=development expo prebuild --platform ios --clean",
    "start": "expo start",
    "client": "expo start --dev-client",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "sdk-coverage": "bun scripts/sdk-coverage.mjs",
    "smoke:plugin": "bun scripts/smoke-plugin.mjs",
    "smoke:gateway": "bun scripts/smoke-gateway.mjs",
    "smoke": "bun run smoke:plugin && bun run smoke:gateway",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "web": "expo start --web",
    "build:android": "bunx eas-cli build --platform android --profile production",
    "build:android:apk": "mkdir -p dist/releases && bunx eas-cli build --platform android --profile sideload --wait --non-interactive --json > dist/releases/android-apk-build.json",
    "download:android:apk": "bun scripts/download-android-apk.mjs",
    "checksum:android:apk": "bun scripts/checksum-android-apk.mjs",
    "release:android:apk": "bun run typecheck && bun run build:android:apk && bun run download:android:apk && bun run checksum:android:apk",
    "submit:android": "bunx eas-cli submit --platform android --profile production --latest",
    "release:android": "bun run build:android && bun run submit:android",
    "build:ios": "bunx eas-cli build --platform ios --profile production",
    "submit:ios": "bunx eas-cli submit --platform ios --profile production",
    "release:ios": "bun run build:ios && bun run submit:ios"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@opencode-ai/sdk": "^1.15.3",
    "expo": "^55.0.24",
    "expo-build-properties": "~55.0.14",
    "expo-camera": "~55.0.18",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.34",
    "expo-device": "^55.0.17",
    "expo-font": "~55.0.7",
    "expo-notifications": "^55.0.23",
    "expo-secure-store": "~55.0.14",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.16",
    "punycode": "^2.3.1",
    "react": "^19.2.0",
    "react-native": "0.83.6",
    "react-native-markdown-display": "^7.0.2",
    "react-native-sse": "^1.2.1",
    "react-native-zeroconf": "^0.14.0"
  },
  "devDependencies": {
    "@babel/runtime": "^7.28.4",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@types/bun": "^1.3.14",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@testing-library/react-native": "^13.3.3",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.0",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-reanimated": "^4.4.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-worklets": "^0.9.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!\\.bun/|((jest-)?react-native|@react-native(-community)?|expo|expo-.*|@expo(nent)?/.*|@expo-google-fonts/.*|react-native-.*)/)"
    ]
  },
  "private": true
}