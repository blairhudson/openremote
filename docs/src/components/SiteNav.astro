---
interface Props {
  docsMenu?: boolean;
}

import { discordUrl, repoUrl } from "../content/site-links";

const { docsMenu = false } = Astro.props;
---

<nav class="topbar" aria-label="Primary navigation">
  <div class="topbar-inner">
    {docsMenu ? (
      <div class="topbar-brand-row">
        <a class="brand" href="/" aria-label="OpenRemote home">
          <img src="/openremote-wordmark.svg" alt="openremote" />
        </a>
        <label class="docs-menu-button" for="docs-menu-toggle" aria-label="Toggle docs navigation" role="button" tabindex="0">
          <span></span>
          <span></span>
          <span></span>
        </label>
      </div>
    ) : (
      <a class="brand" href="/" aria-label="OpenRemote home">
        <img src="/openremote-wordmark.svg" alt="openremote" />
      </a>
    )}
    <div class="nav-links">
      <a href="/docs">docs</a>
      <a href="/news">news</a>
      <a href="/roadmap">roadmap</a>
      <a class="nav-icon" href={repoUrl} aria-label="GitHub" target="_blank" rel="noreferrer">
        <svg class="button-icon" viewBox="0 0 16 16" aria-hidden="true">
          <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
      </a>
      <a class="nav-icon" href={discordUrl} aria-label="Discord" target="_blank" rel="noreferrer">
        <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M20.32 4.37A19.79 19.79 0 0 0 15.36 2a13.78 13.78 0 0 0-.64 1.32 18.27 18.27 0 0 0-5.44 0A13.78 13.78 0 0 0 8.64 2a19.79 19.79 0 0 0-4.96 2.37C.55 9.05-.3 13.62.1 18.13A19.9 19.9 0 0 0 6.18 21.2a14.5 14.5 0 0 0 1.3-2.1 12.9 12.9 0 0 1-2.05-.98c.17-.13.34-.26.5-.4a14.2 14.2 0 0 0 12.14 0c.16.14.33.27.5.4-.65.39-1.34.72-2.05.98.37.73.8 1.43 1.3 2.1a19.9 19.9 0 0 0 6.08-3.07c.48-5.23-.82-9.75-3.58-13.76ZM8.02 15.33c-1.18 0-2.15-1.08-2.15-2.42s.95-2.42 2.15-2.42c1.2 0 2.17 1.09 2.15 2.42 0 1.34-.95 2.42-2.15 2.42Zm7.96 0c-1.18 0-2.15-1.08-2.15-2.42s.95-2.42 2.15-2.42c1.2 0 2.17 1.09 2.15 2.42 0 1.34-.95 2.42-2.15 2.42Z" />
