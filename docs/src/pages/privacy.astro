---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { siteUrl } from "../content/site-links";

const pageTitle = "OpenRemote Privacy Policy";
const pageDescription = "Privacy policy for the OpenRemote mobile app.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#151718" />
    <meta property="og:site_name" content="OpenRemote" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}/privacy`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={`${siteUrl}/og-image.jpg`} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.jpg`} />
    <link rel="canonical" href={`${siteUrl}/privacy`} />
    <link rel="icon" type="image/svg+xml" href="/openremote-icon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteNav />

    <main class="page-shell roadmap-page-shell">
      <header class="roadmap-hero news-hero">
        <h1>Privacy Policy</h1>
        <p class="lede">Last updated: May 24, 2026</p>
      </header>

      <section class="roadmap-section news-section" aria-label="OpenRemote privacy policy">
        <article class="news-post">
          <p>OpenRemote does not collect, sell, or share personal data.</p>
          <p>OpenRemote connects directly to the OpenCode server you choose. The app may send connection details, chat messages, command output, session information, and permission choices to that server so the app can work.</p>
          <p>OpenRemote does not operate a cloud service for app data.</p>
          <p>Connection details may be stored locally on your device to make reconnecting easier.</p>
          <p>Apple, Google, Expo, GitHub, or other distribution platforms may process app install, download, account, or crash information under their own privacy policies.</p>
          <p>For questions, open an issue at <a class="inline-link" href="https://github.com/blairhudson/openremote/issues" target="_blank" rel="noreferrer">github.com/blairhudson/openremote/issues</a>.</p>
        </article>
      </section>
      <SiteFooter />
    </main>
  </body>
</html>
